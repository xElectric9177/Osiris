{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "id": "amendale.bar",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "amendale.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "amendale.media"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "amendale.cpu"
        },
        {
          "id": "amendale.gpu"
        },
        {
          "id": "amendale.memory"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "cloneSourceRestores": [
    "amendale.media",
    "amendale.lock",
    "amendale.menu"
  ],
  "disabledPlugins": [
    "omarchy.media",
    "omarchy.lock",
    "omarchy.menu"
  ],
  "idle": {
    "lock": 1200,
    "screensaver": 900
  },
  "plugins": [
    {
      "id": "amendale.lock"
    },
    {
      "id": "amendale.cpu"
    },
    {
      "id": "amendale.gpu"
    },
    {
      "id": "amendale.memory"
    }
  ],
  "version": 1
}
