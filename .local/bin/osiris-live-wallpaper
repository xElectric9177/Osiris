#!/bin/bash
# Starts (or stops) the Osiris live wallpaper to match the active theme.
#
# Shared by two hooks so the launch flags live in exactly one place:
#   theme-set.d/  - theme changed, start or stop to match
#   post-boot.d/  - session started, nothing else would launch it
#
# Usage: osiris-live-wallpaper [theme-name]
#        With no argument, reads the currently active theme.

THEME_NAME="${1:-$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)}"
VIDEO="$HOME/.config/omarchy/themes/osiris/backgrounds/osiris-live.mp4"

pkill -9 -f "mpvpaper.*osiris-live\.mp4" 2>/dev/null
# SIGTERM isn't reliably reaped before the next mpvpaper claims the layer
# surface, so hard-kill and give it a moment to actually release before
# remapping — otherwise two instances briefly fight over the same output.
for i in 1 2 3 4 5; do
  pgrep -f "mpvpaper.*osiris-live\.mp4" >/dev/null || break
  sleep 0.2
done

if [[ "$THEME_NAME" == "osiris" && -f "$VIDEO" ]] && command -v mpvpaper >/dev/null; then
  # -l bottom is load-bearing, not a preference.
  #
  # Omarchy's shell paints the still wallpaper on its own layer-shell surface,
  # `omarchy-background`, which sits in the *background* layer — the same one
  # mpvpaper defaults to. Within one layer, Hyprland stacks by map order, so
  # whichever surface mapped last wins. mpvpaper maps at boot/theme-set; the
  # shell remaps `omarchy-background` every time it restarts (an update, a
  # plugin reload, `omarchy restart shell`). After any shell restart the still
  # image lands on top and the video is buried — still decoding at ~35% CPU,
  # just invisible.
  #
  # The *bottom* layer is a whole level above *background*, so this ordering
  # can't be lost to a race no matter what remaps or when. Windows still draw
  # above the bottom layer, so it behaves exactly like a wallpaper.
  mpvpaper -f -p -l bottom -o "no-audio loop" ALL "$VIDEO"
fi
